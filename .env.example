# Discord Bot Token (取得自 Discord Developer Portal)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Google Gemini API Key (取得自 Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# 預設使用的 Gemini 模型
GEMINI_MODEL=gemini-3.5-flash-lite

# 專屬聊天室頻道 ID（留空代表不限制頻道）
ALLOWED_CHANNEL_ID=1567111900402286763
